---
import logoSvg from '@/assets/logo-brand.svg?raw';
import Button from '@/components/Button.astro';
import { navLinks } from '@/config/nav';
import { site } from '@/data/site';

// strip Astro's trailing slash so the current path matches nav.ts
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const joinLink = navLinks.find((link) => link.href === '/join-team');
const primaryLinks = navLinks.filter((link) => link.href !== '/join-team');
---
<nav class="site-nav" data-site-nav>
	<a class="site-nav__brand" href="/" aria-label={`${site.name} — home`} data-nav-brand>
		<Fragment set:html={logoSvg} />
	</a>

	<button
		class="site-nav__toggle"
		type="button"
		aria-label="Menu"
		aria-expanded="false"
		aria-controls="site-nav-menu"
		data-nav-toggle
	>
		<span></span>
		<span></span>
		<span></span>
	</button>

	{/* display: contents above the breakpoint, so the desktop grid is untouched */}
	<div class="site-nav__menu" id="site-nav-menu">
		<ul class="site-nav__links">
			{primaryLinks.map((link) => (
				<li>
					<a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
						{link.label}
					</a>
				</li>
			))}
		</ul>

		{joinLink && (
			<div class="site-nav__cta">
				<Button href={joinLink.href} text={joinLink.label} size="small" />
			</div>
		)}
	</div>
</nav>

<style>
	.site-nav {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 50;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: var(--nav-height);
		padding: 8px 80px;
		background-color: var(--surface-scrim);
		backdrop-filter: blur(6px);
		border-bottom: 1px solid var(--color-accent);
	}

	.site-nav__brand {
		height: 80px;

		/* the two tones the inlined SVG paints with */
		--logo-mark: var(--color-accent);
		--logo-word: var(--color-cream);
	}

	/* over a cream chapter the cream wordmark vanishes, so both tones darken */
	.site-nav[data-over-bright='true'] .site-nav__brand {
		--logo-mark: var(--color-brand);
		--logo-word: var(--color-brand-deep);
	}

	.site-nav__brand :global(svg) {
		display: block;
		width: auto;
		height: 100%;
	}

	/* :global because set:html content carries no scope hash. A CSS rule beats
	   the SVG's own fill attribute, which stays put so the footer's <img> copy
	   of the same file still renders in its original colours. */
	.site-nav__brand :global(.logo-mark) {
		fill: var(--logo-mark);
		transition: fill 300ms ease;
	}

	.site-nav__brand :global(.logo-word) {
		fill: var(--logo-word);
		transition: fill 300ms ease;
	}

	.site-nav__menu {
		display: contents;
	}

	.site-nav__links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__cta {
		justify-self: end;
	}

	.site-nav__links a {
		color: var(--color-text);
		text-decoration: none;
		padding-bottom: 2px;
		white-space: nowrap;
		transition: color 0.4s ease;
	}

	.site-nav__links a:hover {
		transition: color 300ms ease;
		color: var(--color-accent-bright);
	}

	.site-nav__links a[aria-current='page'] {
		color: var(--color-accent-bright);
	}

	.site-nav__toggle {
		display: none;
		grid-column: 3;
		justify-self: end;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 5px;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.site-nav__toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--color-accent);
		transition: transform 300ms ease, opacity 200ms ease, background-color 300ms ease;
	}

	.site-nav__toggle:hover span {
		background-color: var(--color-accent-bright);
	}

	.site-nav__toggle:focus-visible {
		outline: 1px solid var(--color-white);
		outline-offset: 2px;
	}

	/* bars sit at 0 / 7 / 14px, so the outer two meet in the middle at ±7 */
	.site-nav[data-open='true'] .site-nav__toggle span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.site-nav[data-open='true'] .site-nav__toggle span:nth-child(2) {
		opacity: 0;
	}

	.site-nav[data-open='true'] .site-nav__toggle span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* long labels overflow on smaller laptops, so padding and gap tighten first */
	@media (max-width: 1300px) {
		.site-nav {
			padding: 8px 40px;
		}

		.site-nav__links {
			gap: 1.75rem;
		}
	}

	@media (max-width: 1080px) {
		.site-nav {
			padding: 8px 24px;
		}

		.site-nav__links {
			gap: 1.15rem;
		}

		.site-nav__links a {
			font-size: 0.9rem;
		}
	}

	/* below this the six labels stop fitting beside the brand and the CTA */
	@media (max-width: 900px) {
		/* the panel is a second grid row of the bar rather than its own layer, so
		   the bar's backdrop-filter covers both. A nested backdrop-filter would
		   sample the bar instead of the page and blur nothing at all. */
		.site-nav {
			grid-template-columns: 1fr auto;
			grid-template-rows: var(--nav-height) 0fr;
			height: auto;
			max-height: 100dvh;
			padding: 0 24px;
			transition: grid-template-rows 250ms ease, backdrop-filter 250ms ease;
		}

		/* heavier blur while open: a bar's worth of scrim is not enough contrast
		   behind a full panel of links */
		.site-nav[data-open='true'] {
			grid-template-rows: var(--nav-height) 1fr;
			backdrop-filter: blur(18px);
		}

		.site-nav__toggle {
			grid-column: 2;
			display: flex;
		}

		.site-nav__menu {
			grid-column: 1 / -1;

			/* stretch, not centre: the closed row is 0fr and a centred item would
			   spill out of it */
			align-self: stretch;
			display: block;
			min-height: 0;
			overflow: hidden;
			opacity: 0;
			visibility: hidden;
			transition: opacity 200ms ease, visibility 0s linear 200ms;
		}

		.site-nav[data-open='true'] .site-nav__menu {
			overflow-y: auto;
			opacity: 1;
			visibility: visible;
			transition: opacity 200ms ease 50ms, visibility 0s;
		}

		.site-nav__links {
			display: block;
		}

		.site-nav__links li + li {
			border-top: 1px solid var(--border-cream-faint);
		}

		.site-nav__links a {
			display: block;
			padding: 14px 0;
			font-size: 1rem;
		}

		.site-nav__cta {
			justify-self: stretch;
			margin: 20px 0 24px;
		}

		.site-nav__cta .btn {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav__menu,
		.site-nav__toggle span,
		.site-nav__brand :global(.logo-mark),
		.site-nav__brand :global(.logo-word) {
			transition-duration: 0s;
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-site-nav]');
	const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const brand = nav?.querySelector<HTMLElement>('[data-nav-brand]');

	/* The brand is cream-on-dark, which disappears over a cream chapter. Rather
	   than track scroll offsets, hit-test the point the logo actually covers:
	   elementsFromPoint honours the sections' diagonal clip-paths, which a
	   bounding-box test (IntersectionObserver) would not. */
	if (nav && brand) {
		const BRIGHT = '.section--bright, .section--accent';
		let queued = false;

		const syncTone = () => {
			queued = false;

			const box = brand.getBoundingClientRect();
			const stack = document.elementsFromPoint(
				box.left + box.width / 2,
				box.top + box.height / 2,
			);

			nav.dataset['overBright'] = String(stack.some((el) => el.matches(BRIGHT)));
		};

		const queue = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(syncTone);
		};

		addEventListener('scroll', queue, { passive: true });
		addEventListener('resize', queue);
		syncTone();
	}

	if (nav && toggle) {
		const setOpen = (open: boolean) => {
			nav.dataset['open'] = String(open);
			toggle.setAttribute('aria-expanded', String(open));
		};

		toggle.addEventListener('click', () => {
			setOpen(nav.dataset['open'] !== 'true');
		});

		// a tapped link navigates, but same-page anchors would otherwise leave it open
		nav.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('click', (event) => {
			if (!nav.contains(event.target as Node)) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && nav.dataset['open'] === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});

		// so an open panel never leaks into the desktop layout on resize
		window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});

		setOpen(false);
	}
</script>
