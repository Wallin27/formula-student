---
import Button from '@/components/Button.astro';
import { navLinks } from '@/config/nav';
import { site } from '@/data/site';

// strip Astro's trailing slash so the current path matches nav.ts
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const joinLink = navLinks.find((link) => link.href === '/join-team');
const primaryLinks = navLinks.filter((link) => link.href !== '/join-team');
---
<nav class="site-nav">
	<a class="site-nav__brand" href="/">
		<img src="/assets/logo-brand.svg" alt={`${site.name} — home`} width="36" height="19" />
	</a>

	<ul class="site-nav__links">
		{primaryLinks.map((link) => (
			<li>
				<a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
					{link.label}
				</a>
			</li>
		))}
	</ul>

	{joinLink && (
		<div class="site-nav__cta">
			<Button href={joinLink.href} text={joinLink.label} size="small" />
		</div>
	)}
</nav>

<style>
	.site-nav {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 50;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: 100px;
		padding: 8px 80px;
		background-color: var(--surface-scrim);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		border-bottom: 1px solid var(--color-accent);
	}

	.site-nav__brand {
		height: 80px;
	}

	.site-nav__brand img {
		display: block;
		width: auto;
		height: 100%;
	}

	.site-nav__links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__cta {
		justify-self: end;
	}

	.site-nav__links a {
		color: var(--color-text);
		text-decoration: none;
		padding-bottom: 2px;
		white-space: nowrap;
		transition: color 0.4s ease;
	}

	.site-nav__links a:hover {
		transition: color 300ms ease;
		color: var(--color-accent-bright);
	}

	.site-nav__links a[aria-current='page'] {
		color: var(--color-accent-bright);
	}

	/* long labels overflow on smaller laptops, so padding and gap tighten first */
	@media (max-width: 1300px) {
		.site-nav {
			padding: 8px 40px;
		}

		.site-nav__links {
			gap: 1.75rem;
		}
	}

	@media (max-width: 1080px) {
		.site-nav {
			padding: 8px 24px;
		}

		.site-nav__links {
			gap: 1.15rem;
		}

		.site-nav__links a {
			font-size: 0.9rem;
		}
	}
</style>
