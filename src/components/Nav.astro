---
import Button from '@/components/Button.astro';
import { navLinks } from '@/config/nav';
import { site } from '@/data/site';

// strip Astro's trailing slash so the current path matches nav.ts
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const joinLink = navLinks.find((link) => link.href === '/join-team');
const primaryLinks = navLinks.filter((link) => link.href !== '/join-team');
---
<nav class="site-nav" data-site-nav>
	<a class="site-nav__brand" href="/">
		<img src="/assets/logo-brand.svg" alt={`${site.name} — home`} width="36" height="19" />
	</a>

	<button
		class="site-nav__toggle"
		type="button"
		aria-label="Menu"
		aria-expanded="false"
		aria-controls="site-nav-menu"
		data-nav-toggle
	>
		<span></span>
		<span></span>
		<span></span>
	</button>

	{/* display: contents above the breakpoint, so the desktop grid is untouched */}
	<div class="site-nav__menu" id="site-nav-menu">
		<ul class="site-nav__links">
			{primaryLinks.map((link) => (
				<li>
					<a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
						{link.label}
					</a>
				</li>
			))}
		</ul>

		{joinLink && (
			<div class="site-nav__cta">
				<Button href={joinLink.href} text={joinLink.label} size="small" />
			</div>
		)}
	</div>
</nav>

<style>
	.site-nav {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 50;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: 100px;
		padding: 8px 80px;
		background-color: var(--surface-scrim);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		border-bottom: 1px solid var(--color-accent);
	}

	.site-nav__brand {
		height: 80px;
	}

	.site-nav__brand img {
		display: block;
		width: auto;
		height: 100%;
	}

	.site-nav__menu {
		display: contents;
	}

	.site-nav__links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__cta {
		justify-self: end;
	}

	.site-nav__links a {
		color: var(--color-text);
		text-decoration: none;
		padding-bottom: 2px;
		white-space: nowrap;
		transition: color 0.4s ease;
	}

	.site-nav__links a:hover {
		transition: color 300ms ease;
		color: var(--color-accent-bright);
	}

	.site-nav__links a[aria-current='page'] {
		color: var(--color-accent-bright);
	}

	.site-nav__toggle {
		display: none;
		grid-column: 3;
		justify-self: end;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 5px;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.site-nav__toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--color-accent);
		transition: transform 300ms ease, opacity 200ms ease, background-color 300ms ease;
	}

	.site-nav__toggle:hover span {
		background-color: var(--color-accent-bright);
	}

	.site-nav__toggle:focus-visible {
		outline: 1px solid var(--color-white);
		outline-offset: 2px;
	}

	/* bars sit at 0 / 7 / 14px, so the outer two meet in the middle at ±7 */
	.site-nav[data-open='true'] .site-nav__toggle span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.site-nav[data-open='true'] .site-nav__toggle span:nth-child(2) {
		opacity: 0;
	}

	.site-nav[data-open='true'] .site-nav__toggle span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* long labels overflow on smaller laptops, so padding and gap tighten first */
	@media (max-width: 1300px) {
		.site-nav {
			padding: 8px 40px;
		}

		.site-nav__links {
			gap: 1.75rem;
		}
	}

	@media (max-width: 1080px) {
		.site-nav {
			padding: 8px 24px;
		}

		.site-nav__links {
			gap: 1.15rem;
		}

		.site-nav__links a {
			font-size: 0.9rem;
		}
	}

	/* below this the six labels stop fitting beside the brand and the CTA */
	@media (max-width: 900px) {
		.site-nav {
			grid-template-columns: 1fr auto;
		}

		.site-nav__toggle {
			display: flex;
		}

		.site-nav__menu {
			display: block;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			max-height: calc(100dvh - 100px);
			overflow-y: auto;
			padding: 8px 24px 24px;
			background-color: rgb(var(--rgb-deep) / 96%);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
			border-bottom: 1px solid var(--color-accent);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-8px);
			transition: opacity 250ms ease, transform 250ms ease, visibility 0s linear 250ms;
		}

		.site-nav[data-open='true'] .site-nav__menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
			transition: opacity 250ms ease, transform 250ms ease, visibility 0s;
		}

		.site-nav__links {
			display: block;
		}

		.site-nav__links li + li {
			border-top: 1px solid var(--border-cream-faint);
		}

		.site-nav__links a {
			display: block;
			padding: 14px 0;
			font-size: 1rem;
		}

		.site-nav__cta {
			justify-self: stretch;
			margin-top: 20px;
		}

		.site-nav__cta .btn {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav__menu,
		.site-nav__toggle span {
			transition-duration: 0s;
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-site-nav]');
	const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');

	if (nav && toggle) {
		const setOpen = (open: boolean) => {
			nav.dataset['open'] = String(open);
			toggle.setAttribute('aria-expanded', String(open));
		};

		toggle.addEventListener('click', () => {
			setOpen(nav.dataset['open'] !== 'true');
		});

		// a tapped link navigates, but same-page anchors would otherwise leave it open
		nav.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('click', (event) => {
			if (!nav.contains(event.target as Node)) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && nav.dataset['open'] === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});

		// so an open panel never leaks into the desktop layout on resize
		window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});

		setOpen(false);
	}
</script>
