---
/**
 * The closing "come build with us" chapter. Shared by the home and team pages;
 * pass the buttons in as children.
 */
interface Props {
	id: string;
	title: string;
	text: string;
	/** Extra .section modifiers, e.g. "section--cut-reverse". */
	class?: string | undefined;
}

const { id, title, text, class: className } = Astro.props;
---
<section class:list={['section', 'section--cut', 'cta', className]} aria-labelledby={id}>
	<div class="section__inner cta__inner">
		<h2 id={id} class="cta__title">{title}</h2>
		<p class="cta__text">{text}</p>
		<div class="cta__actions">
			<slot />
		</div>
	</div>
</section>

<style>
	.cta {
		background: var(--bg-void);
		text-align: center;
	}

	.cta__inner {
		max-width: 760px;
	}

	.cta__title {
		margin: 0 0 20px;
		color: var(--color-white);
		font-size: var(--text-6xl);
		line-height: var(--leading-6xl);
		font-family: var(--font-heading);
		text-transform: uppercase;
	}

	.cta__text {
		margin: 0 0 48px;
		color: var(--color-text);
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
	}

	.cta__actions {
		display: flex;
		justify-content: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	@media (max-width: 900px) {
		.cta__title {
			font-size: var(--text-4xl);
			line-height: var(--leading-4xl);
		}
	}
</style>
