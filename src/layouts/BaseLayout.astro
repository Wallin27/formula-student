---
import '@/styles/global.css';
import Nav from '@/components/Nav.tsx';
import Footer from '@/components/Footer.tsx';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Umeå Formula Student- Engineered in the North', 
	description = 'Umeå Formula Student — a student-run Formula Student motorsport team from Umeå Universitet, designing and racing an electric all-wheel-drive race car.',	
} = Astro.props;

const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <Nav currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
