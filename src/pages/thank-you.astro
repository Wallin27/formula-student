---
import Button from '@/components/Button.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { site } from '@/data/site';
import PageLayout from '@/layouts/PageLayout.astro';
---
{/* Netlify redirects here after a successful join-team submission. */}
<PageLayout
	title={`Application received — ${site.name}`}
	description="Your application has been received."
	background="carbon"
	variant="centered"
>
	<Eyebrow text="Application received" stripes={2} align="center" size="sm" spacing="none" />

	<h1 class="title">Thanks for applying</h1>

	<p class="lead">
		We have your application and everything you attached. We read every one of
		them, and will get back to you as soon as we can.
	</p>

	<div class="actions">
		<Button href="/" text="Back to the start" size="large" variant="secondary" />
	</div>
</PageLayout>

<style>
	.title {
		margin: 24px 0 0;
		font-size: var(--text-8xl);
		line-height: 1.05;
		color: var(--color-white);
		text-transform: uppercase;
	}

	.lead {
		max-width: 52ch;
		margin: 24px auto 0;
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
		color: var(--color-text);
	}

	.actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 40px;
	}
</style>
