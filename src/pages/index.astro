---
import { Image } from 'astro:assets';
import crowd from '@/assets/lineup.jpg';
import Button from '@/components/Button.astro';
import CallToAction from '@/components/CallToAction.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout>
	<!-- 1. Hero + slogan -->
	<section class="hero" aria-labelledby="hero-heading">
		<div class="hero__inner">
			<div class="hero__left">
				<Eyebrow text="New Formula Student Team · Umeå" stripes={2} size="sm" />

				<h1 id="hero-heading" class="hero__title">
					From zero to<br /> grid by 2027
				</h1>
			</div>

			<div class="hero__right">
				<p class="hero__lead">
					A newly founded Formula Student team of students from different
					programmes, aiming to compete in summer 2027. Sound interesting?
					Read more below!
				</p>

				<div class="hero__actions">
					<Button href="/join-team" text="Join us" />
					<Button href="/team" text="Learn about the team" variant="secondary" />
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Our Vision / bright chapter -->
	<section
		class="section section--bright section--cut vision"
		aria-labelledby="vision-heading"
	>
		<div class="section__inner">
			<div class="vision__layout">
				<div>
					<Eyebrow text="Our vision" tone="deep" stripes={2} />

					<h2 id="vision-heading" class="section__title">More than a car</h2>

					<p class="section__text">
						Our goal isn't just to build a car by summer 2027. It's to create
						an environment where students can grow, learn, and prepare for
						their future careers. Through hands-on experience in engineering,
						teamwork, and project management, we want every member to leave the
						team better equipped for the professional world than when they
						joined.
					</p>
				</div>

				<aside class="vision__aside">
					<p class="vision__aside-label">First competition</p>
					<span class="vision__aside-value">Summer 2027</span>
					<p class="vision__aside-label">Open to</p>
					<span class="vision__aside-value">Every programme</span>
					<p class="vision__aside-label">Built in</p>
					<span class="vision__aside-value">Umeå</span>
				</aside>
			</div>
		</div>
	</section>

	<!-- 3. FS info -->
	<section
		class="section section--cut section--cut-reverse fs-intro"
		aria-labelledby="fs-intro-heading"
	>
		<div class="section__bg" aria-hidden="true">
			<Image
				class="section__bg-img"
				src={crowd}
				alt=""
				widths={[960, 1440, 1920, 2560]}
				sizes="100vw"
				decoding="async"
			/>
		</div>

		<div class="section__inner">
			<div class="fs-intro__layout">
				<div>
					<Eyebrow text="The competition" stripes={2} />

					<h2 id="fs-intro-heading" class="section__title">
						What is Formula Student?
					</h2>
				</div>

				<div>
					<p class="fs-intro__text">
						Formula Student is the world's largest engineering design
						competition. University teams design, build, and race
						formula-style vehicles, judged on engineering excellence, cost
						efficiency, and performance.
					</p>
					<Button
						href="/formula-student"
						text="Read about the competition here"
						size="large"
					/>
				</div>
        
			</div>
		</div>
	</section>

	<!-- 4. Build with us -->
	<CallToAction
		id="home-cta-heading"
		title="Build it with us"
		text="We are recruiting across every discipline: mechanical, electrical, software, business and design. No experience required."
	>
		<Button href="/join-team" text="Submit an application" size="large" />
		<Button href="/team" text="Learn about the team" size="large" variant="secondary" />
	</CallToAction>
</BaseLayout>

<style>
	/* ----- Hero ----- */

	.hero {
		display: flex;
		flex-direction: column;
		position: relative;
		min-height: 100dvh;
		padding: 100px 60px 76px;
		overflow: hidden;
		background: var(--bg-paddock);
	}

	/* fixes the height of the hero when it's followed by a cut section */
	.hero:has(+ .section--cut) {
		min-height: calc(100dvh + var(--cut-depth));
		padding-bottom: calc(76px + var(--cut-depth));
	}

	.hero::before {
		position: absolute;
		top: 50%;
		left: 15%;

		/* shrinks to porpotion to the vp */
		width: min(130vmax, 3000px);
		height: min(130vmax, 3000px);
		background: url('/assets/brand.svg') center / contain no-repeat;
		opacity: 0.1;
		content: '';
		transform: translateY(-50%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-end;
		margin-top: auto;
	}

	.hero__left {
		flex: 0 1 auto;
		
		/* without this the flex item cannot shrink under its content */
		min-width: 0;
	}

	.hero__right {
		/* never spans the whole row */
		flex: 1 1 0;
		align-self: flex-end;
		max-width: 45rem;
		min-width: 0;
		padding-left: 60px;
	}

	.hero__title {
		color: var(--color-white);
		text-transform: uppercase;
	}

	.hero__lead {
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
		color: var(--color-text);
	}

	/* nowrap buttons set the right column's min-content width, which is what
	   held it open and squeezed the title as the viewport narrowed */
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	/* ----- Vision ----- */

	.vision {
		background: var(--bg-cream);
	}

	.vision__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: 72px;
		align-items: center;
	}

	.vision__aside {
		padding: 32px 0 32px 40px;
		border-left: 1px solid rgb(var(--rgb-accent) / 40%);
	}

	.vision__aside-label {
		margin: 0 0 10px;
		color: var(--color-gold-deep);
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.vision__aside-value {
		display: block;
		margin-bottom: 28px;
		font-size: var(--text-3xl);
		line-height: var(--leading-3xl);
		font-family: var(--font-heading);
	}

	.vision__aside-value:last-child {
		margin-bottom: 0;
	}

	/* ----- Formula Student chapter ----- */

	.fs-intro {
		background: var(--bg-carbon);
	}

	.fs-intro__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		gap: 72px;
		align-items: start;
	}

	.fs-intro__text {
		margin: 0 0 32px;
		color: var(--color-text);
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
	}

	@media (max-width: 900px) {
		.hero__inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 32px;
		}

		/* flex-basis follows the main axis, so the row's width rules would size
		   these by height once the inner flips to a column */
		.hero__left,
		.hero__right {
			flex: 0 0 auto;
		}

		.hero__left {
			width: 100%;
		}

		.hero__right {
			align-self: auto;
			padding-left: 0;
		}

		.vision__layout,
		.fs-intro__layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 40px;
		}

		.vision__aside {
			padding: 0 0 0 24px;
		}
	}

	@media (max-width: 720px) {
		.hero {
			padding: calc(var(--nav-height) + 40px) 24px 76px;
		}

		.hero__inner {
			flex-direction: column;
			margin-top: 0;
			flex: 1;
			justify-content: space-between;
			align-items: center;
			gap: 32px;
			text-align: center;
		}

		.hero__left {
			width: 100%;
		}

		.hero__right {
			align-self: auto;
			padding-left: 0;
		}

		/* eyebrow = prop is why we need child */
		.hero__left :global(.eyebrow) {
			justify-content: center;
		}

		.hero__lead {
			max-width: 46ch;
			margin-inline: auto;
		}

		.hero__actions {
			flex-wrap: wrap;
			justify-content: center;
		}

		.hero::before {
			top: 42%;
			left: 50%;
			width: min(170vmax, 3000px);
			height: min(170vmax, 3000px);
			transform: translate(-50%, -50%);
		}
	}
</style>
