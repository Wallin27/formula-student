---
import ContactForm from '@/components/ContactForm';
import Eyebrow from '@/components/Eyebrow.astro';
import { mailto, site } from '@/data/site';
import PageLayout from '@/layouts/PageLayout.astro';
---
<PageLayout
	title={`Contact — ${site.name}`}
	description={`Get in touch with ${site.name}.`}
	background="carbon"
>
	<header class="intro">
		<h1 class="title">Contact</h1>

		<Eyebrow text="Get in touch" stripes={2} align="center" size="sm" spacing="above" />

		<p class="lead">
			Sponsorship, inquiries, or just curious about what we are
			building? <br /> Write to us and we will get back to you.
		</p>
	</header>

	<div class="body">
		<ContactForm client:load />

		<aside class="aside">
			<h2 class="aside__title">Reach us directly</h2>
			<address class="aside__block">
				<a href={mailto}>{site.email}</a>
				<span>{site.address.line1}</span>
				<span>{site.address.line2}</span>
			</address>
		</aside>
	</div>
</PageLayout>

<style>

	.intro {
		margin-bottom: 80px;
		text-align: center;
	}

	.title {
		margin: 0;
		font-size: clamp(2.75rem, 8vw, var(--text-8xl));
		line-height: 1.05;
		color: var(--color-white);
		text-transform: uppercase;
	}

	.lead {
		max-width: 58ch;
		margin: 32px auto 0;
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
		color: var(--color-white);
	}

	.body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
		gap: 64px;
		align-items: start;
	}

	.aside__title {
		margin: 0 0 20px;
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: 1.3;
		color: var(--color-white);
	}

	.aside__block {
		display: grid;
		gap: 6px;
		font-size: var(--text-base);
		font-style: normal;
		line-height: var(--leading-lg);
		color: var(--color-text);
	}

	.aside__block a {
		color: var(--color-accent);
		text-decoration: none;
		transition: color 200ms ease;
	}

	.aside__block a:hover {
		color: var(--color-accent-bright);
	}

	@media (max-width: 900px) {
		.body {
			grid-template-columns: minmax(0, 1fr);
			gap: 48px;
		}
	}

	@media (max-width: 720px) {
		.intro {
			margin-bottom: 56px;
		}
	}
</style>
