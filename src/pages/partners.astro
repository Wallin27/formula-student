---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import lineup from '@/assets/crowd.jpg';
import Button from '@/components/Button.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { steps } from '@/data/partners';
import { mailto, site } from '@/data/site';
import PageLayout from '@/layouts/PageLayout.astro';

/* the folder is the list: drop a logo in src/assets/partners/ and it shows up */
const logos = Object.entries(
	import.meta.glob<{ default: ImageMetadata }>(
		'/src/assets/partners/*.{png,jpg,jpeg,webp,svg}',
		{ eager: true },
	),
)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([path, file]) => ({
		image: file.default,
		/* 'ansys.png' -> 'Ansys', so the logo still has alt text */
		name: (path.split('/').pop() ?? '')
			.replace(/\.\w+$/, '')
			.replace(/[-_]/g, ' ')
			.replace(/^./, (c) => c.toUpperCase()),
	}));
---
<PageLayout
	title={`Partners — ${site.name}`}
	description={`The partners powering ${site.name}'s first electric race car.`}
	background="flat"
>
	<div class="bg" aria-hidden="true" slot="background">
		<Image
			class="bg__img"
			src={lineup}
			alt=""
			widths={[960, 1440, 1920, 2560]}
			sizes="100vw"
			decoding="async"
		/>
	</div>

	<header class="intro">
		<h1 class="title">Our partners</h1>

		<Eyebrow text="Partners & Sponsors" stripes={2} align="center" size="sm" spacing="above" />

		<p class="lead">
			Season one is being built from nothing. Here are all the kind people and
			companies that share our vision and are helping us make it a reality.
		</p>
	</header>

	<section class="roster" aria-labelledby="roster-heading">
		<h2 id="roster-heading" class="roster__title">The ones backing us</h2>

		<p class="roster__note">
			<span class="roster__note-label">Our first partner</span>
			The first company to back the team, on board before we had a workshop,
			a chassis, or a single ordered part. Many thanks to the Ansys team for believing in us and helping us get started.
		</p>

		<ul class="roster__grid" role="list">
			{logos.map((logo) => (
				<li class="partner">
					<Image
						class="partner__logo"
						src={logo.image}
						alt={logo.name}
						densities={[1, 2]}
						loading="lazy"
						decoding="async"
					/>
				</li>
			))}
		</ul>
	</section>

	<section
		class="section section--bright section--cut apply"
		aria-labelledby="apply-heading"
		slot="after"
	>
		<div class="section__inner">
			<Eyebrow text="Apply for sponsorship" tone="deep" stripes={2} />

			<h2 id="apply-heading" class="apply__title">Become a partner</h2>
			<p class="apply__intro">
				Every krona and every donated hour goes into the first Formula Student car ever built in Umeå. In return you get placement on the car, access to the students behind it, and a relationship with the team that will be building it for years to come. We are happy to discuss any kind of support, from financial to expertise to material, and we are open to creative ideas.
			</p>

			<div class="apply__layout">
				<ul class="apply__steps">
					{steps.map((step) => (
						<li class="apply__step">
							<h3 class="apply__step-title">{step.title}</h3>
							<p class="apply__step-text">{step.text}</p>
						</li>
					))}
				</ul>

				<div class="apply__panel">
					<p class="apply__panel-title">Start the conversation</p>
					<p class="apply__step-text">
						We answer every mail, and we are happy to come to you and present
						the project in person.
					</p>
					<p class="apply__contact">
						<a class="apply__link" href={mailto}>{site.email}</a>
					</p>
					<Button href="/contact" text="Send us a message" variant="cream" />
				</div>
			</div>
		</div>
	</section>
</PageLayout>

<style>
	/* the media layer sits outside .page__inner, behind the content */
	.bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.bg__img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;

		/* a viewport-relative band, not a %: the section grows as sponsors are added */
		height: min(125vh, 1300px);
		object-fit: cover;
		object-position: center 35%;
		opacity: 0.38; /* 0.30-0.45 keeps body text readable */
		mix-blend-mode: luminosity;
		-webkit-mask-image: linear-gradient(to bottom, var(--color-black) 0%, var(--color-black) 40%, transparent 100%);
		mask-image: linear-gradient(to bottom, var(--color-black) 0%, var(--color-black) 40%, transparent 100%);
	}

	/* darkens the top so the white title and gold eyebrow keep their contrast */
	.bg::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgb(var(--rgb-deep) / 62%) 0%,
			transparent 30%
		);
		content: '';
	}

	/* ----- Intro ----- */

	.intro {
		margin-bottom: 160px;
		text-align: center;
	}

	.title {
		margin: 0;
		font-size: var(--text-8xl);
		line-height: 1.05;
		color: var(--color-white);
		text-transform: uppercase;
	}

	.lead {
		max-width: 58ch;
		margin: 32px auto 0;
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
		color: var(--color-white);
	}

	/* ----- Partner roster ----- */

	.roster__title {
		margin: 0;
		color: var(--color-white);
		font-size: var(--text-4xl);
		line-height: 1.2;
		font-family: var(--font-heading);
		text-transform: uppercase;
		text-align: center;
	}

	.roster__note {
		max-width: 46ch;
		margin: 28px auto 0;
		padding: 18px 24px;
		border: 1px solid var(--border-accent-soft);
		border-radius: 12px;
		background: var(--surface-veil);
		color: var(--color-white);
		font-size: var(--text-base);
		line-height: var(--leading-2xl);
		text-align: center;
	}

	.roster__note-label {
		display: block;
		margin-bottom: 6px;
		color: var(--color-accent);
		font-size: 0.6875rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	/* flex, not grid: a half-full last row stays centred, so the roster grows
	   outward from the middle instead of filling in from the left */
	.roster__grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 28px;
		margin: 56px 0 0;
		padding: 0;
		list-style: none;
	}

	/* no tile of its own — just an equal-sized slot every logo sits in */
	.partner {
		display: grid;
		flex: 0 1 260px;
		max-width: 320px;
		aspect-ratio: 3 / 2;
		padding: 28px;
	}

	/* the img fills the tile's content box and object-fit does the centring, so
	   it lands dead centre on both axes whatever shape the logo is */
	.partner__logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center center;
		transition: transform 240ms ease;
	}

	.partner:hover .partner__logo {
		transform: scale(1.06);
	}

	@media (prefers-reduced-motion: reduce) {
		.partner__logo {
			transition: none;
		}

		.partner:hover .partner__logo {
			transform: none;
		}
	}

	/* ----- "Become a partner" chapter ----- */

	.apply__title {
		margin: 0 0 16px;
		font-size: var(--text-5xl);
		line-height: var(--leading-5xl);
		font-family: var(--font-heading);
		text-transform: uppercase;
	}

	.apply__intro {
		max-width: 62ch;
		margin: 0 0 64px;
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
	}

	/* steps run down the left, the contact panel sits alongside them */
	.apply__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
		gap: 72px;
		align-items: start;
	}

	.apply__steps {
		display: grid;
		gap: 36px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.apply__step {
		padding-top: 28px;
		border-top: 1px solid rgb(var(--rgb-gold-deep) / 45%);
	}

	.apply__step-title {
		margin: 0 0 10px;
		color: var(--color-brand-deep);
		font-size: var(--text-xl);
		line-height: var(--leading-xl);
		font-family: var(--font-heading);
	}

	.apply__step-text {
		margin: 0;
		color: rgb(var(--rgb-deep) / 72%);
		font-size: var(--text-base);
		line-height: var(--leading-2xl);
	}

	.apply__panel {
		position: sticky;
		top: 120px;
		padding: 40px;
		border: 1px solid var(--border-deep-faint);
		border-radius: 14px;
		background: var(--surface-light);
	}

	.apply__panel-title {
		margin: 0 0 20px;
		color: var(--color-gold-deep);
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.apply__contact {
		margin: 24px 0 28px;
		font-size: var(--text-base);
		line-height: var(--leading-2xl);
	}

	.apply__link {
		color: var(--color-gold-link);
	}

	/* fallback for engines without blend modes: a plain green veil */
	@supports not (mix-blend-mode: luminosity) {
		.bg__img {
			opacity: 0.25;
			filter: grayscale(1);
		}
	}

	@media (max-width: 900px) {
		.apply__title {
			font-size: var(--text-3xl);
			line-height: var(--leading-3xl);
		}

		.apply__layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 48px;
		}

		.apply__panel {
			position: static;
			padding: 28px;
		}
	}

	@media (max-width: 720px) {
		.intro {
			margin-bottom: 100px;
		}

		.roster__grid {
			gap: 20px;
			margin-top: 40px;
		}

		.roster__title {
			font-size: var(--text-3xl);
			line-height: var(--leading-3xl);
		}
	}
</style>
