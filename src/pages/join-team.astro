---
import Eyebrow from '@/components/Eyebrow.astro';
import { mailto, site } from '@/data/site';
import { departments } from '@/data/subgroups';
import { studyYears } from '@/data/team';
import PageLayout from '@/layouts/PageLayout.astro';
---
<PageLayout
	title={`Join the Team — ${site.name}`}
	description={`Apply to join ${site.name} — a student-run motorsport team from Umeå Universitet building the north's first electric race car.`}
	background="carbon"
>
	<header class="intro">
		<Eyebrow text="Recruitment open" stripes={2} size="sm" spacing="none" />

		<h1 class="title">Join the team</h1>

		<p class="lead">
			We are building the first Formula Student car in Umeå from an empty
			workshop. No experience required — only that you want to learn, and
			that you show up.
		</p>
	</header>

	<div class="grid">
		<aside class="aside">
			<div class="box">
				<h2 class="box__title">Before you apply (?)</h2>
				<p class="box__text">
					lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
					efficitur, nisl vel tincidunt lacinia, nunc est laoreet nunc, nec
				</p>
			</div>

			<ul class="facts" role="list">
				<li class="fact">
					<span class="fact__label">Commitment</span>
					<span class="fact__value">~6 h / week</span>
				</li>
				<li class="fact">
					<span class="fact__label">Season</span>
					<span class="fact__value">Aug — Jul</span>
				</li>
				<li class="fact">
					<span class="fact__label">Title</span>
					<span class="fact__value">Placeholder</span>
				</li>
				<li class="fact">
					<span class="fact__label">Open to</span>
					<span class="fact__value">All programmes</span>
				</li>
			</ul>

			<p class="aside__note">
				Questions before you send anything? Send us an email at:
				<a class="link" href={mailto}>{site.email}</a>
			</p>
		</aside>

		<form class="form" method="post" action="#" enctype="multipart/form-data">
			<div class="row">
				<div class="field">
					<label class="label" for="name">Full name</label>
					<input class="input" id="name" name="name" type="text" autocomplete="name" required />
				</div>

				<div class="field">
					<label class="label" for="email">Email</label>
					<input class="input" id="email" name="email" type="email" autocomplete="email" required />
				</div>
			</div>

			<div class="row">
				<div class="field">
					<label class="label" for="programme">Programme</label>
					<input
						class="input"
						id="programme"
						name="programme"
						type="text"
						placeholder="e.g. Civilingenjör i Teknisk Fysik"
						required
					/>
				</div>

				<div class="field field--narrow">
					<label class="label" for="study-year">Study year</label>
					<select class="input select" id="study-year" name="studyYear" required>
						<option value="" selected disabled>Select</option>
						{studyYears.map((year) => <option value={year}>{year}</option>)}
					</select>
				</div>
			</div>

			<div class="field">
				<label class="label" for="department">Department</label>
				<select class="input select" id="department" name="department" required>
					<option value="" selected disabled>Where do you want to work?</option>
					{departments.map((dept) => <option value={dept}>{dept}</option>)}
				</select>
			</div>

			<div class="row">
				<div class="field">
					<label class="label" for="resume">
						Resume <span class="hint">PDF</span>
					</label>
					<input
						class="input file"
						id="resume"
						name="resume"
						type="file"
						accept=".pdf,.doc,.docx"
						required
					/>
				</div>

				<div class="field">
					<label class="label" for="cover-letter">
						Cover letter <span class="hint">PDF</span>
					</label>
					<input
						class="input file"
						id="cover-letter"
						name="coverLetter"
						type="file"
						accept=".pdf,.doc,.docx"
					/>
				</div>
			</div>

			<div class="field">
				<label class="label" for="about">
					Short about you <span class="hint">Max 600 characters</span>
				</label>
				<textarea
					class="input textarea"
					id="about"
					name="about"
					rows="5"
					maxlength="600"
					placeholder="What draws you to the team, and what do you want to build?"
				></textarea>
			</div>

			<div class="submit-row">
				<p class="disclaimer">
					Your files are used for recruitment only and are deleted after the
					season.
				</p>
				<button class="btn btn--large btn--secondary" type="submit">
					Send application
				</button>
			</div>
		</form>
	</div>
</PageLayout>

<style>
	.intro {
		max-width: 62ch;
		margin-bottom: 88px;
	}

	.title {
		margin: 20px 0 0;
		font-size: clamp(2.75rem, 8vw, var(--text-8xl));
		line-height: 1.05;
		color: var(--color-white);
		text-transform: uppercase;
	}

	.lead {
		margin: 24px 0 0;
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
		color: var(--color-text);
	}

	/* ----- Two-column shell: info left, form right ----- */

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: 72px;
		align-items: start;
	}

	/* ----- Aside ----- */

	.aside {
		position: sticky;
		top: 120px; /* clears the fixed nav */
	}

	.box {
		padding: 28px;
		border: 1px solid var(--border-accent);
		background: var(--surface-panel);
		backdrop-filter: blur(6px);
	}

	.box__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: var(--leading-xl);
		color: var(--color-accent);
	}

	.box__text {
		margin: 12px 0 0;
		font-size: var(--text-base);
		line-height: var(--leading-lg);
		color: var(--color-text);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px; /* the gap itself draws the hairline grid */
		margin: 20px 0 0;
		padding: 0;
		border: 1px solid var(--border-cream-faint);
		background: var(--border-cream-faint);
		list-style: none;
	}

	.fact {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 18px 20px;
		background: var(--surface-panel);
	}

	.fact__label {
		font-size: 0.6875rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.fact__value {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		line-height: 1.2;
		color: var(--color-white);
	}

	.aside__note {
		margin: 24px 0 0;
		font-size: 0.875rem;
		line-height: var(--leading-lg);
		color: var(--color-text);
	}

	.link {
		color: var(--color-accent);
		text-decoration-color: var(--border-accent);
		text-underline-offset: 3px;
	}

	.link:hover,
	.link:focus-visible {
		color: var(--color-accent-bright);
	}

	/* ----- Form ----- */

	.form {
		display: grid;
		gap: 20px;
		padding: 40px;
		border: 1px solid var(--border-cream-soft);
		background: rgb(var(--rgb-deep) / 42%);
		backdrop-filter: blur(8px);
	}

	.row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}

	/* study year needs far less room than the programme name beside it */
	.row:has(.field--narrow) {
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
	}

	.field {
		display: grid;
		gap: 8px;
	}

	.label {
		font-size: 0.6875rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.hint {
		letter-spacing: 0.12em;
		text-transform: none;
		color: var(--text-dim);
	}

	.input {
		width: 100%;
		min-height: 48px;
		padding: 12px 16px;
		border: 1px solid var(--border-cream-soft);
		border-radius: 0;
		background: rgb(var(--rgb-black) / 26%);
		font: inherit;
		color: var(--color-white);
		transition: border-color 250ms ease, background-color 250ms ease, box-shadow 250ms ease;
	}

	.input::placeholder {
		color: rgb(var(--rgb-cream) / 40%);
	}

	.input:hover {
		border-color: rgb(var(--rgb-cream) / 34%);
	}

	/* the second pixel is drawn inward so the ring reads as 2px without resizing the field */
	.input:focus-visible {
		border-color: var(--color-accent);
		box-shadow: inset 0 0 0 1px var(--color-accent);
		background: rgb(var(--rgb-black) / 38%);
		outline: none;
	}

	/* only flag fields the user has actually left, not empty ones on first paint */
	.input:user-invalid {
		border-color: var(--color-danger);
	}

	.select {
		appearance: none;
		padding-right: 44px;

		/* a data URI cannot read a custom property: %23C6A15B is --color-accent, change both */
		background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'%3E%3Cpath fill='none' stroke='%23C6A15B' stroke-width='1.5' d='M1 1.5 6 6.5 11 1.5'/%3E%3C/svg%3E");
		background-repeat: no-repeat;
		background-position: right 16px center;
		background-size: 12px 8px;
		cursor: pointer;
	}

	/* the OS paints the dropdown list, so it needs opaque colours */
	.select option {
		background: var(--color-brand-deep);
		color: var(--color-white);
	}

	.file {
		padding: 8px;
		font-size: 0.875rem;
		color: var(--color-text);
		cursor: pointer;
	}

	.file::file-selector-button {
		margin-right: 14px;
		padding: 8px 16px;
		border: 1px solid var(--color-accent);
		border-radius: 0;
		background: transparent;
		font: inherit;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		cursor: pointer;
		transition: border-color 250ms ease, color 250ms ease;
	}

	.file:hover::file-selector-button {
		border-color: var(--color-accent-bright);
		color: var(--color-accent-bright);
	}

	.textarea {
		min-height: 140px;
		line-height: var(--leading-lg);
		resize: vertical;
	}

	.submit-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-top: 8px;
	}

	.disclaimer {
		flex: 1 1 26ch;
		margin: 0;
		font-size: 0.8125rem;
		line-height: var(--leading-base);
		color: var(--text-dim);
	}

	@media (max-width: 1000px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 48px;
		}

		.aside {
			position: static;
		}
	}

	@media (max-width: 720px) {
		.intro {
			margin-bottom: 56px;
		}

		.form {
			padding: 24px;
		}

		/* two inputs side by side stop being usable below ~360px each */
		.row,
		.row:has(.field--narrow) {
			grid-template-columns: minmax(0, 1fr);
		}

		.submit-row {
			flex-direction: column;
			align-items: stretch;
		}
	}

	/* high-contrast mode strips borders, so the focus ring needs a real outline */
	@media (forced-colors: active) {
		.input:focus-visible {
			outline: 2px solid Highlight;
			outline-offset: 0;
		}
	}
</style>
