---
import Eyebrow from '@/components/Eyebrow.astro';
import {
	competitionTotal,
	dynamicEvents,
	dynamicTotal,
	staticEvents,
	staticTotal,
} from '@/data/competition';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const groups = [
	{
		id: 'static',
		title: 'Static events',
		total: staticTotal,
		desc: 'Judged by industry engineers. Won in the workshop and the spreadsheet, long before the car turns a wheel.',
		events: staticEvents,
	},
	{
		id: 'dynamic',
		title: 'Dynamic events',
		total: dynamicTotal,
		desc: 'Driven over several days. Endurance alone is worth roughly a third of the entire competition — finishing it is the first real goal for any new team.',
		events: dynamicEvents,
	},
];
---
<BaseLayout
	title={`Formula Student — ${site.name}`}
	description="What Formula Student is, and how the world's largest engineering design competition is scored."
>
	<section class="section fs-hero" aria-labelledby="fs-heading">
		<div class="section__inner">
			<Eyebrow text="The competition" />

			<h1 id="fs-heading" class="section__title">
				What is Formula Student?
			</h1>

			<p class="section__text">
				Formula Student is the world's largest engineering design competition.
				University teams design, build, and race formula-style vehicles, judged
				on engineering excellence, cost efficiency, and performance.
			</p>

			<p class="fs-hero__body">
				It runs as a season, not a weekend. Teams spend a full academic year
				taking a car from a blank sheet through design, manufacturing and
				testing, then bring it to an international event to be measured against
				universities from across the world. The competition deliberately
				rewards more than lap time — which is why teams are built from every
				discipline: mechanical, electrical, software, business and design.
			</p>
		</div>
	</section>

	<section
		class="section section--bright section--cut fs-format"
		aria-labelledby="fs-format-heading"
	>
		<div class="section__inner">
			<h2 id="fs-format-heading" class="fs-format__title">
				How the competition works
			</h2>
			<p class="fs-format__intro">
				A competition is split into static events, judged off the track, and
				dynamic events, driven on it. Every car must first pass technical
				scrutineering — a full safety inspection — before it is allowed to run.
				Points from both halves are added together to decide the standings.
			</p>

			<div class="fs-format__groups">
				{groups.map((group) => (
					<article class="fs-group">
						<div class="fs-group__head">
							<h3 class="fs-group__title">{group.title}</h3>
							<span class="fs-group__points">{group.total} pts</span>
						</div>
						<p class="fs-group__desc">{group.desc}</p>
						<ul class="fs-group__list" role="list">
							{group.events.map((event) => (
								<li class="fs-event">
									<span class="fs-event__name">
										{event.name}
										<span class="fs-event__desc">{event.desc}</span>
									</span>
									<span class="fs-event__points">{event.points}</span>
								</li>
							))}
						</ul>
					</article>
				))}
			</div>

			<div class="fs-format__total">
				<p class="fs-format__total-label">Total available</p>
				<span class="fs-format__total-value">{competitionTotal}</span>
			</div>

			<p class="fs-format__note">
				Scoring shown follows the Formula Student Germany electric ruleset.
				Individual competitions weight events slightly differently — confirm
				against the rulebook for the event you enter.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.fs-hero {
		background: var(--bg-mesh);
	}

	.fs-hero__body {
		max-width: 62ch;
		margin: 28px 0 0;
		color: var(--color-text);
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
	}

	/* ----- How it works ----- */

	/* runs on the bright variant — see styles/sections.css */

	.fs-format__title {
		margin: 0 0 16px;
		color: var(--color-brand-deep);
		font-size: var(--text-5xl);
		line-height: var(--leading-5xl);
		font-family: var(--font-heading);
		text-transform: uppercase;
	}

	.fs-format__intro {
		max-width: 62ch;
		margin: 0 0 64px;
		color: var(--text-on-cream);
		font-size: var(--text-lg);
		line-height: var(--leading-2xl);
	}

	.fs-format__groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: 32px;
	}

	.fs-group {
		padding: 36px;
		border: 1px solid var(--border-deep-faint);
		border-radius: 14px;
		background: var(--surface-light);
	}

	.fs-group__head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		margin-bottom: 8px;
	}

	.fs-group__title {
		margin: 0;
		color: var(--color-brand-deep);
		font-size: var(--text-2xl);
		line-height: var(--leading-2xl);
		font-family: var(--font-heading);
		text-transform: uppercase;
	}

	.fs-group__points {
		flex-shrink: 0;
		color: var(--color-gold-deep);
		font-size: var(--text-lg);
		font-family: var(--font-heading);
	}

	.fs-group__desc {
		margin: 0 0 28px;
		color: rgb(var(--rgb-deep) / 68%);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.fs-group__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.fs-event {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		padding: 14px 0;
		border-top: 1px solid rgb(var(--rgb-deep) / 12%);
	}

	.fs-event__name {
		color: rgb(var(--rgb-deep) / 88%);
		font-size: var(--text-base);
	}

	.fs-event__desc {
		display: block;
		margin-top: 4px;
		color: rgb(var(--rgb-deep) / 58%);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.fs-event__points {
		flex-shrink: 0;
		color: var(--color-gold-deep);
		font-size: 0.9rem;
		font-family: var(--font-heading);
		font-variant-numeric: tabular-nums;
	}

	.fs-format__total {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid rgb(var(--rgb-gold-deep) / 55%);
	}

	.fs-format__total-label {
		margin: 0;
		color: var(--color-gold-deep);
		font-size: var(--text-base);
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}

	.fs-format__total-value {
		color: var(--color-brand-deep);
		font-size: var(--text-3xl);
		font-family: var(--font-heading);
	}

	.fs-format__note {
		margin: 24px 0 0;
		color: rgb(var(--rgb-deep) / 58%);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.fs-format__title {
			font-size: var(--text-3xl);
			line-height: var(--leading-3xl);
		}

		.fs-group {
			padding: 24px;
		}
	}
</style>
